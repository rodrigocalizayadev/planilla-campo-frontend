# Copiar a .env en el servidor (mismo directorio que docker-compose.prod.yml).
# El front no tiene secretos, pero deploy.sh exige que el .env exista.

# Puerto del host donde escucha el front. 127.0.0.1 = solo accesible vía reverse proxy local.
# 8080 lo usa la API: no reutilizarlo.
WEB_BIND=127.0.0.1
WEB_PORT=8081
